<?xml version="1.0" encoding="UTF-8"?>
<dao-class xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="dao.xsd">

    <crud dto="sqlx-Category" table="Categories"/>
    <crud dto="sqlx-Customer" table="Customers"/>

    <crud dto="sqlx-Employee" table="Employees"/>

    <crud dto="EmployeesTerritory" table="EmployeesTerritories"/>
    <query-dto-list method="getEmployeesTerritoriesByEmployee(employee_id)" dto="EmployeesTerritory"
                    ref="EmployeesTerritories(EmployeeID)"/>
    <query-dto-list method="getEmployeesTerritoriesByTerritory(territory_id)" dto="EmployeesTerritory"
                    ref="EmployeesTerritories(TerritoryID)"/>

    <crud dto="sqlx-InternationalOrder" table="InternationalOrders"/>
    <query-dto-list method="getInternationalOrdersByOrder(order_id)" dto="sqlx-InternationalOrder"
                    ref="InternationalOrders(OrderID)"/>

    <crud dto="sqlx-OrderDetail" table="OrderDetails"/>
    <query-dto-list method="getOrderDetailsByOrder(order_id)" dto="sqlx-OrderDetail" ref="OrderDetails(OrderID)"/>
    <query-dto-list method="getOrderDetailsByProduct(product_id)" dto="sqlx-OrderDetail" ref="OrderDetails(ProductID)"/>

<!--    <crud dto="sqlx-Order" table="Orders"/>-->
    <query-dto-list method="getOrdersByCustomer(customer_id)" dto="sqlx-Order" ref="Orders(CustomerID)"/>

    <crud dto="sqlx-PreviousEmployee" table="PreviousEmployees"/>

    <crud dto="sqlx-Product" table="Products"/>
    <query-dto-list method="getProductsBySupplier(supplier_id)" dto="sqlx-Product" ref="Products(SupplierID)"/>
    <query-dto-list method="getProductsByCategory(category_id)" dto="sqlx-Product" ref="Products(CategoryID)"/>

    <crud dto="sqlx-Region" table="Regions"/>

    <crud dto="sqlx-Supplier" table="Suppliers"/>

    <crud dto="sqlx-Territory" table="Territories"/>
    <query-dto-list method="getTerritoriesByRegion(region_id)" dto="sqlx-Territory" ref="Territories(RegionID)"/>

</dao-class>