<?xml version="1.0" encoding="UTF-8"?>
<dao-class xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="dao.xsd">

    <crud dto="PagesStat">
        <create method="createPagesStat"/>
        <update method="updatePagesStat"/>
        <delete method="deletePagesStat"/>
    </crud>

    <query-dto-list method="readPagesStatList" dto="PagesStat"
                    ref="select * from pages_stat order by visits_count desc"/>

    <query-dto method="get_by_http_referer(http_referer)" dto="PagesStat"
               ref="select * from pages_stat where http_referer=?"/>

</dao-class>