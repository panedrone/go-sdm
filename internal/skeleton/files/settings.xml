<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="settings.xsd">

    <!-- Paths are relative to the project root (the folder of go.mod).
         The generated code is the data layer of the application: keep it under internal/. -->

    <!-- target: "module" from go.mod; sql: base folder of SQL files -->

    <folders target="{{module}}" sql="{{sql}}"/>

    <!-- scope: folder of generated models; field-names-mode: 0 - TitleCase -->

    <dto scope="{{dto}}" inheritance="" field-names-mode="0" macro=""/>

    <!-- scope: folder of generated DAO files

         field-assign-mode:
            0 - by column name (database/sql, gorm)
            1 - by field position
            2 - ptr to DTO or ptr to slice of DTO-s (sqlx)
            3 - ptr to resulting slice of DTO-s (sqlx) -->

    <dao scope="{{dao}}" field-assign-mode="{{assign}}" macro=""/>

    <ide event-log="true"/>

    <!-- url: postgres://host:port/db, mysql://host:port/db or sqlite:<file>.
         SDM_PWD, if set, overrides "pwd". -->

    <jdbc url="postgres://localhost:5432/postgres" user="postgres" pwd=""/>

    <!-- detected: the type of a column as the driver names it. The keys below are PostgreSQL
         (int4, varchar, timestamptz, ...). MySQL says INT, VARCHAR, DATETIME, UNSIGNED BIGINT, ...;
         SQLite says what the column is declared with: INTEGER, VARCHAR, ...

         To see which names your database gives, empty the type-map: <type-map default=""/>
         and generate. The code then has the raw names of the driver instead of Go types.

         A class is generated for database/sql, sqlx or gorm by its name in sdm.xml:
            <dto-class name="Task" ...>       - the keys without prefix
            <dto-class name="sqlx-Task" ...>  - the keys with "sqlx-"
            <dto-class name="gorm-Task" ...>  - the keys with "gorm-" ("+auto" - auto="..." column)
         The data store in the DAO folder has to match: sdm init -orm no_orm, sqlx or gorm.
         The sets you don't use can be removed or commented out. -->

    <type-map default="">

        <!-- database/sql (no ORM) -->

        <type detected="int2" target="int16${json} -> SetInt16"/>
        <type detected="int4" target="int32${json} -> SetInt32"/>
        <type detected="int8" target="int64${json} -> SetInt64"/>
        <type detected="float4" target="float32${json} -> SetFloat32"/>
        <type detected="float8" target="float64${json} -> SetFloat64"/>
        <type detected="numeric" target="float64${json} -> SetFloat64"/>
        <type detected="varchar" target="string${json} -> SetString"/>
        <type detected="text" target="string${json} -> SetString"/>
        <type detected="bpchar" target="string${json} -> SetString"/>
        <type detected="json" target="string${json} -> SetString"/>
        <type detected="jsonb" target="string${json} -> SetString"/>
        <type detected="bytea" target="[]byte${json} -> SetBytes"/>
        <type detected="bool" target="bool${json} -> SetBool"/>
        <type detected="date" target="time:time.Time${json} -> SetTime"/>
        <type detected="timestamp" target="time:time.Time${json} -> SetTime"/>
        <type detected="timestamptz" target="time:time.Time${json} -> SetTime"/>
        <type detected="uuid" target="github.com/google/uuid:uuid.UUID${json} -> Scan"/>
        <type detected="_text" target="[]string${json}"/>
        <type detected="_varchar" target="[]string${json}"/>
        <type detected="refcursor" target="string"/>

        <!-- sqlx -->

        <type detected="sqlx-int2" target="int16${json-sqlx} -> SetInt16"/>
        <type detected="sqlx-int4" target="int32${json-sqlx} -> SetInt32"/>
        <type detected="sqlx-int8" target="int64${json-sqlx} -> SetInt64"/>
        <type detected="sqlx-float4" target="float32${json-sqlx} -> SetFloat32"/>
        <type detected="sqlx-float8" target="float64${json-sqlx} -> SetFloat64"/>
        <type detected="sqlx-numeric" target="float64${json-sqlx} -> SetFloat64"/>
        <type detected="sqlx-varchar" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-text" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-bpchar" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-json" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-jsonb" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-bytea" target="[]byte${json-sqlx} -> SetBytes"/>
        <type detected="sqlx-bool" target="bool${json-sqlx} -> SetBool"/>
        <type detected="sqlx-date" target="time:time.Time${json-sqlx} -> SetTime"/>
        <type detected="sqlx-timestamp" target="time:time.Time${json-sqlx} -> SetTime"/>
        <type detected="sqlx-timestamptz" target="time:time.Time${json-sqlx} -> SetTime"/>
        <type detected="sqlx-uuid" target="github.com/google/uuid:uuid.UUID${json-sqlx}"/>
        <type detected="sqlx-_text" target="[]string${json-sqlx}"/>
        <type detected="sqlx-_varchar" target="[]string${json-sqlx}"/>

        <!-- gorm -->

        <type detected="gorm-int2" target="int16${json-gorm} -> SetInt16"/>
        <type detected="gorm-int4" target="int32${json-gorm} -> SetInt32"/>
        <type detected="gorm-int8" target="int64${json-gorm} -> SetInt64"/>
        <type detected="gorm-float4" target="float32${json-gorm} -> SetFloat32"/>
        <type detected="gorm-float8" target="float64${json-gorm} -> SetFloat64"/>
        <type detected="gorm-numeric" target="float64${json-gorm} -> SetFloat64"/>
        <type detected="gorm-varchar" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-text" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-bpchar" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-json" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-jsonb" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-bytea" target="[]byte${json-gorm} -> SetBytes"/>
        <type detected="gorm-bool" target="bool${json-gorm} -> SetBool"/>
        <type detected="gorm-date" target="${json-gorm-time}"/>
        <type detected="gorm-timestamp" target="${json-gorm-time}"/>
        <type detected="gorm-timestamptz" target="${json-gorm-time}"/>
        <type detected="gorm-uuid" target="github.com/google/uuid:uuid.UUID${json-gorm}|1:;type:uuid"/>
        <type detected="gorm-uuid+auto"
              target="github.com/google/uuid:uuid.UUID${json-gorm}|1:;type:uuid;default:gen_random_uuid()"/>
        <type detected="gorm-_text" target="[]string${json-gorm}"/>
        <type detected="gorm-_varchar" target="[]string${json-gorm}"/>

    </type-map>

    <macros>

        <macro value="=built-in=" name="${column}"/>
        <macro value="=built-in=" name="${lower_snake_case(column)}"/>
        <macro value="=built-in=" name="${camelCase(column)}"/>
        <macro value="=built-in=" name="${TitleCase(column)}"/>
        <macro value="=built-in=" name="${kebab-case(column)}"/>

        <macro name="${json-col}" value="${lower_snake_case(column)}"/>

        <macro name="${json}" value=" `json:&quot;${json-col}${0}&quot;`"/>

        <macro name="${json-sqlx}" value=" `json:&quot;${json-col}${0}&quot; db:&quot;${column}&quot;`"/>

        <macro name="${json-gorm}"
               value=" `json:&quot;${json-col}${0}&quot; gorm:&quot;column:${column}${gorm-params}${1}&quot;`"/>

        <macro name="${json-gorm-time}" value="time:time.Time${json-gorm} -> SetTime"/>

        <!-- gorm tag parameters from the metadata of the column -->
        <macro name="${gorm-params}">
            <vm-xml>
                <if var="$fi.ColumnSize > 0">
                    <print var=";size:$fi.ColumnSize"/>
                </if>
                <if var="$fi.PK">
                    <print var=";primaryKey"/>
                    <if var="$fi.AI">
                        <print var=";autoIncrement"/>
                    </if>
                    <else>
                        <if var="$fi.Unique &amp;&amp; $fi.Indexed">
                            <print var=";uniqueIndex"/>
                            <else>
                                <if var="$fi.Unique">
                                    <print var=";unique"/>
                                </if>
                                <if var="$fi.Indexed">
                                    <print var=";index"/>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
                <if var="!$fi.Nullable">
                    <print var=";not null"/>
                </if>
            </vm-xml>
        </macro>

    </macros>

</settings>
